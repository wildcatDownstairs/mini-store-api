# 复制为 .env；脚本不会自动加载。按 README 设置环境变量。
PGHOST=/tmp
PGPORT=5432
PGUSER=your_local_postgres_role
PGPASSWORD=
PGDATABASE=ecommerce_lab
SEED=20260918
SEED_SCALE=medium
SEED_AS_OF=2026-09-18T00:00:00+00:00

# 启动器自动生成本地随机密钥；直接 dotnet run 时请在环境中设置自己的随机值。
# Auth__SigningKey=
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5274
# 可选完整连接串，设置后优先于 PG*；不要提交真实值。
# ConnectionStrings__EcommerceLab=
