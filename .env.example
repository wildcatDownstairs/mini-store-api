# 复制为 .env；脚本不会自动加载。按 README 设置环境变量。
PGHOST=/tmp
PGPORT=5432
PGUSER=your_local_postgres_role
PGPASSWORD=
PGDATABASE=ecommerce_lab
SEED=20260918
SEED_SCALE=medium
SEED_AS_OF=2026-09-18T00:00:00+00:00

# 启动器自动生成本地随机密钥；直接 dotnet run 时请在环境中设置自己的随机值。
# Auth__SigningKey=
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5274
# 报价令牌的 Data Protection 密钥目录，默认 .local/data-protection-keys；多实例或容器需挂载同一目录。
# DataProtection__KeysPath=
# 反向代理 IP；只有配置后才信任 X-Forwarded-For，用于按真实客户端 IP 限流。
# ForwardedHeaders__KnownProxies__0=127.0.0.1
# 可选完整连接串，设置后优先于 PG*；不要提交真实值。
# ConnectionStrings__EcommerceLab=
